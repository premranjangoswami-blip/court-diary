{
  "name": "court-diary",
  "version": "1.0.0",
  "description": "Court Diary Management System for a Lawyer's Office",
  "scripts": {
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test:server": "jest --testPathPattern=server/tests --forceExit",
    "test:client": "npm run test --prefix client",
    "test": "npm run test:server",
    "install:all": "npm install && npm install --prefix client"
  },
  "dependencies": {
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "express-validator": "^7.0.1",
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/server/tests/**/*.test.js"],
    "forceExit": true
  }
}
